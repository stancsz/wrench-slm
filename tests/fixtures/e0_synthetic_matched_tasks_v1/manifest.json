      "group": "localization",
      "pair_id": "loc-function-name",
      "changed_boundary_fact": "the exact function identifier that checks expiry",
      "cases": [
        {
          "case_id": "loc-a",
          "prompt": "Read src/cache.py with a 1024 byte limit.",
          "files": [
            {
              "path": "src/cache.py",
              "content_utf8": "def is_expired(entry):\n    return entry.expires_at <= 0\n",
              "sha256": "063fed81fafd7c385262d6d44304c3b05f51f86a10a7a3ac9e6f6e094f952766"
            },
            {
              "path": "src/near_match.py",
              "content_utf8": "def is_expired_preview(entry):\n    return False\n",
              "sha256": "8b3bb430ea3672a1f32f5b771a214775d1cd34fdcf1d6b08baff10c721eb45f1"
            }
          ],
          "expected_mechanics": {
            "status": "completed",
            "action": "read_file",
            "observation": {
              "path": "src/cache.py",
              "text": "def is_expired(entry):\n    return entry.expires_at <= 0\n"
            }
          },
          "answer_oracle": {
            "expected": {
              "symbol": "is_expired",
              "evidence": [
                {
                  "path": "src/cache.py",
                  "line": 1
                }
              ]
            },
            "rule": {
              "kind": "function_for_attribute",
              "source_path": "src/cache.py",
              "attribute": "expires_at"
            }
          }
        },
        {
          "case_id": "loc-b",
          "prompt": "Read src/cache.py with a 1024 byte limit.",
          "files": [
            {
              "path": "src/cache.py",
              "content_utf8": "def needs_refresh(entry):\n    return entry.expires_at <= 0\n",
              "sha256": "08978a87715a1e0f67843a190aca99500015f9b1915bca3a1cdbd599c3c15a84"
            },
            {
              "path": "src/near_match.py",
              "content_utf8": "def is_expired_preview(entry):\n    return False\n",
              "sha256": "8b3bb430ea3672a1f32f5b771a214775d1cd34fdcf1d6b08baff10c721eb45f1"
            }
          ],
          "expected_mechanics": {
            "status": "completed",
            "action": "read_file",
            "observation": {
              "path": "src/cache.py",
              "text": "def needs_refresh(entry):\n    return entry.expires_at <= 0\n"
