              "sha256": "bf37c0432e17122910ea23bbe187a0aa8f70fc09261c37646ba71026dc619fe5"
            },
            {
              "path": "src/legacy.py",
              "content_utf8": "LEGACY_HEADER = 'X-Account'\n",
              "sha256": "f09592340ae1f9d6fc34b4efa56b2725a0ba133d9d024c9caca70aae32c75986"
            }
          ],
          "expected_mechanics": {
            "status": "completed",
            "action": "literal_search",
            "observation": {
              "root": "src",
              "literal": "AUTH_HEADER",
              "matches": [
                {
                  "path": "src/session.py",
                  "line": 1,
                  "text": "AUTH_HEADER = 'X-Account'"
                }
              ],
              "truncated": false,
              "scope": "supplied_snapshot_sources"
            }
          },
          "answer_oracle": {
            "expected": {
              "selected_evidence": [
                "src/session.py"
              ],
              "omitted_distractors": [
                "src/legacy.py"
              ]
            },
            "rule": {
              "kind": "literal_paths",
              "root": "src",
              "literal": "AUTH_HEADER"
            }
          }
        },
        {
          "case_id": "context-b",
          "prompt": "Find the exact text 'AUTH_HEADER' below src, capped at 3 matches.",
          "files": [
            {
