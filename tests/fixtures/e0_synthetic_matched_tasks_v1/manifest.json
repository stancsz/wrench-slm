          "answer_oracle": {
            "expected": {
              "symbol": "needs_refresh",
              "evidence": [
                {
                  "path": "src/cache.py",
                  "line": 1
                }
              ]
            },
            "rule": {
              "kind": "function_for_attribute",
              "source_path": "src/cache.py",
              "attribute": "expires_at"
            }
          }
        }
      ],
      "boundary": {
        "kind": "text_token",
        "path": "src/cache.py",
        "values": {
          "loc-a": "is_expired",
          "loc-b": "needs_refresh"
        }
      }
    },
    {
