{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "wrench-subroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Wrench SubRoute on localhost:4000",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:WRENCH_SUBROUTE_API_KEY}"
      },
      "models": {
        "openrouter": {
          "name": "MiniMax M3 through the forced OpenRouter alias",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    }
  }
}
